
<div class="container">
<h1 class="my-4 text-center">Congolese British Grammar School Gallery</h1>
<div class="table-responsive">
  <table class="table table-bordered table-striped">
    <thead>
      <tr>
        <th>#</th>
        <th class='d-flex justify-content-between'>
         <h5>Image</h5>
         <h5>
         <%= link_to 'Accueil', root_path %>
         </h5>
        </th>
      </tr>
    </thead>
    <tbody>
      <% @galleries.each_with_index do |gallery, index| %>
        <tr>
          <td><%= index + 1 %></td>
          <td>
            <% if gallery.image.present? %>
              <%= image_tag(gallery.image.url, class: "img-fluid") %>
            <% else %>
              <p>Images non disponible</p>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
</div>