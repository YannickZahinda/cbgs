<div class="container">
    <h1 class="my-4 text-center">Upload Image</h1>
    <div class="row justify-content-center">
      <div class="col-md-6">
        <div class="card">
          <div class="card-body">
            <%= form_with(model: @gallery, local: true, html: { class: "form-horizontal" }) do |form| %>
              <div class="form-group">
                <%= form.label :image, class: "col-form-label" %>
                <%= form.file_field :image, class: "form-control-file" %>
              </div>
              <div class="form-group text-center">
                <%= form.submit "Upload", class: "btn btn-primary" %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>