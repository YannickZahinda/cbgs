.container.mt-5
  %p.text-success.text-center= notice
  #communiques.text-center.mt-5
    = link_to(root_path) do
      = image_tag "logos/CBGClogo.png", class: 'my-logo-popup-icon'
    %h1.mb-4 Communiques
    - @communiques.each do |communique|
      .card.mb-4
        .card-body
          %h3.card-title= communique.titre
          - if communique.image.url.present?
            .text-center
              = image_tag communique.image.url, class: 'img-fluid', style: "height: 245px; object-fit: contain"
          - else
            .text-center
              %p.text-muted Pas d'image rattachée
          %p.card-text.mt-3= communique.description
          .text-center.mt-3
            = link_to "Voir", communique, class: "btn btn-dark"