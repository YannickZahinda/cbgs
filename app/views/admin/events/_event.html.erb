<div id="<%= dom_id event %>">
  <div class="card shadow-sm mb-4">
    <div class="card-body">
      <h3 class="card-title mb-3"><%= event.title %></h3>
      <h5 class="card-subtitle mb-4 text-muted"><%= event.date.strftime('%d %b %Y') %></h5>

      <% if event.image.attached? %>
        <div class="text-center mb-4">
          <%= image_tag event.image, class: 'img-fluid', style: 'max-width: 50%; height: auto;' %>
        </div>
      <% end %>

      <p class="card-text mb-4"><%= event.description %></p>

      <div class="d-flex justify-content-between">
        <%= link_to 'Modifier', edit_admin_event_path(event), class: 'btn btn-primary' %>
        <%= button_to 'Effacer', admin_event_path(event), method: :delete, data: { confirm: 'Êtes-vous sûr ?' }, class: 'btn btn-danger' %>
        <%= link_to "Retour aux événements", admin_events_path, class: 'btn btn-outline-secondary' %>
      </div>
    </div>
  </div>
</div>