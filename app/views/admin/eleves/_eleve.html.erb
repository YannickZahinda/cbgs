<div id="<%= dom_id eleve %>" class="card shadow-sm w-50 m-auto">
  <div class="card-header bg-primary text-white">
    <h2 class="card-title mb-0"><%= eleve.nom_complet %></h2>
  </div>
  <div class="card-body">
    <div class="row">
      <div class="col-md-6">
        <div class="mb-3">
          <strong>Addresse:</strong>
          <p class="mb-0"><%= eleve.addresse %></p>
        </div>
        <div class="mb-3">
          <strong>No du parent:</strong>
          <p class="mb-0"><%= eleve.tel_du_parent %></p>
        </div>
        <div class="mb-3">
          <strong>Section:</strong>
          <p class="mb-0"><%= eleve.niveau_etude %></p>
        </div>
      </div>
      <div class="col-md-6">
        <div class="mb-3">
          <strong>Classe:</strong>
          <p class="mb-0"><%= eleve.classe %></p>
        </div>
        <div class="mb-3">
          <strong>ID du parent:</strong>
          <p class="mb-0"><%= eleve.parent_id %></p>
        </div>
        <div class="mb-3">
          <strong>Parent:</strong>
          <p class="mb-0"><%= eleve.parent.nom_complet %></p>
        </div>
        <div class="mb-3">
          <strong>Date de création:</strong>
          <p class="mb-0"><%= eleve.created_at.strftime("%d/%m/%Y %H:%M") %></p>
        </div>
      </div>
    </div>
  </div>
  <div class="card-footer bg-light">
    <div class="d-flex justify-content-between">
      <%= link_to edit_admin_elefe_path(eleve), class: "btn" do %>
        <i class="fas fa-edit"></i> Modifier
      <% end %>
      <%= link_to admin_eleves_path, class: "btn" do %>
        <i class="fas fa-arrow-left"></i> Retour
      <% end %>
      <%= button_to admin_elefe_path(eleve), method: :delete, data: { confirm: "Êtes-vous sûr?" }, class: "btn" do %>
        <i class="fas fa-trash"></i> Effacer
      <% end %>
    </div>
  </div>
</div>