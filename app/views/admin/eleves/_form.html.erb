<div class=" container mt-5 w-50">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
      <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
          <h2 class="card-title mb-0 text-center"><%= eleve.persisted? ? "Modifier élève" : "Créer un Nouvel élève" %></h2>
        </div>
        <div class="card-body">
          <%= form_with(model: [:admin, eleve], local: true, data: { turbo: :false }) do |form| %>
            <% if eleve.errors.any? %>
              <div class="alert alert-danger">
                <h4><%= pluralize(eleve.errors.count, "error") %> prohibited this eleve from being saved:</h4>
                <ul>
                  <% eleve.errors.each do |error| %>
                    <li><%= error.full_message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <div class="mb-3">
              <%= form.label :nom_complet, class: 'form-label' %>
              <%= form.text_field :nom_complet, class: 'form-control' %>
            </div>

            <div class="mb-3">
              <%= form.label :addresse, class: 'form-label' %>
              <%= form.text_field :addresse, class: 'form-control' %>
            </div>

            <div class="mb-3">
              <%= form.label :niveau_etude, class: 'form-label' %>
              <%= form.text_field :niveau_etude, class: 'form-control' %>
            </div>
            <div class="mb-3">
              <%= form.label :classe, class: 'form-label' %>
              <%= form.text_field :classe, class: 'form-control' %>
            </div>
            <div class="mb-3">
              <%= form.label :tel_du_parent, class: 'form-label' %>
              <%= form.text_field :tel_du_parent, class: 'form-control' %>
            </div>
            <div class="mb-3">
              <%= form.label :parent_id %>
              <%= form.text_field :parent_id, class: 'form-control' %>
            </div>
            <div class="d-grid">
              <%= form.submit eleve.persisted? ? "Modifier" : "Créer", class: "btn btn-primary btn-lg" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>








